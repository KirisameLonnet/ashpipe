pkgname=ashpipe-bin
pkgver=0.3.0
pkgrel=1
pkgdesc="cd into a directory, get an SSH session — for humans and AI agents"
arch=('x86_64' 'aarch64')
url="https://github.com/KirisameLonnet/ashpipe"
license=('MIT')
depends=('openssh')
optdepends=('sshfs: transparent file access in portal directories')
